# Plantilla de entorno para Siebe Residences en producción.
#
#   cp .env.siebe .env
#   docker exec siebe_app php artisan key:generate   (o pegá una APP_KEY existente)
#
# Lo que hay que completar antes de levantar: APP_KEY, DB_PASSWORD y el bloque
# COMPANY_ (razón social, datos fiscales y bancarios reales de Siebe).

APP_NAME="Siebe Residences"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://siebe.urbatrix.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# El host `mysql` es el nombre del servicio dentro de la red del compose.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=siebe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Correo. El servidor no puede salir por SMTP (el proveedor bloquea el puerto
# 25), así que va por la API HTTP de Resend, como Bahía Mar. El dominio del
# remitente tiene que estar verificado en Resend.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@urbatrix.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Datos de la empresa ──────────────────────────────────────────────────────
# Alimentan los comprobantes de pago y la hoja de transferencia. Sin estos
# valores los documentos salen con los campos en blanco, que es preferible a
# que salgan con los de otro proyecto.
COMPANY_BRAND=SIEBE
COMPANY_PROJECT="Siebe Residences"
COMPANY_GROUP="Siebe Property Group"
COMPANY_LOCATION=Aruba

COMPANY_LEGAL_NAME=
COMPANY_RNC=
COMPANY_ADDRESS=
COMPANY_SUPPORT_EMAIL=
COMPANY_PHONE=
COMPANY_WEBSITE=sieberesidences.com

COMPANY_BANK_INT_NAME=
COMPANY_BANK_INT_ACCOUNT=
COMPANY_BANK_INT_ADDRESS=
COMPANY_BANK_SWIFT=
COMPANY_BANK_ABA=
COMPANY_BANK_BENEF=
COMPANY_BANK_HOLDER=
COMPANY_BANK_ACCOUNT=

# ── Login con Google ─────────────────────────────────────────────────────────
# Credenciales del cliente OAuth de Siebe (Google Cloud Console → APIs y
# servicios → Credenciales → ID de cliente de OAuth, tipo «Aplicación web»).
# El redirect tiene que coincidir EXACTO con el «URI de redireccionamiento
# autorizado» que se cargue allí, incluido el https y sin barra final.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://siebe.urbatrix.com/auth/google/callback
